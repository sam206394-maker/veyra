# Rename this file to keystore.properties when you have a real signing key.
# Generate one locally with:
#   keytool -genkeypair -v -keystore keystore.jks -alias veyra -keyalg RSA -keysize 2048 -validity 10000
# NEVER commit keystore.properties or keystore.jks to git.
storeFile=keystore.jks
storePassword=change-me
keyAlias=veyra
keyPassword=change-me
