# Veyra - Environment Variables
# Copy to .env.local and configure as needed

# ─── Database ─────────────────────────────────────────────
# Development (SQLite):
DATABASE_URL="file:./../data/veyra.db"
# Production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@localhost:5432/veyra"

# ─── Application ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Demo Mode ────────────────────────────────────────────
# Set to "true" to run without any paid services
DEMO_MODE=true

# ─── AI Provider ──────────────────────────────────────────
# Leave empty to use the built-in mock provider
AI_PROVIDER=
AI_API_KEY=

# ─── Storage ──────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads

# ─── Payments - Stripe ────────────────────────────────────
# Leave empty to use the built-in mock payment provider
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=

# ─── Payments - Razorpay (India) ──────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Pricing (configurable, cents) ────────────────────────
PRICE_STARTER_CENTS=999
PRICE_CREATOR_CENTS=1999
PRICE_PRO_CENTS=4999

# ─── Credits per Plan ─────────────────────────────────────
CREDITS_STARTER=500
CREDITS_CREATOR=2000
CREDITS_PRO=10000

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000
